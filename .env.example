# LLM key for Stagehand (use the provider that matches STAGEHAND_MODEL)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional override — defaults to anthropic/claude-sonnet-4-6 in capture-test.ts
# STAGEHAND_MODEL=anthropic/claude-sonnet-4-6
# STAGEHAND_MODEL=openai/gpt-4o

# Target app under test
APP_URL=https://your-app-url.com
APP_EMAIL=test-account-email
APP_PASSWORD=test-account-password

# --- Postner BE (FastAPI) ---
# Set ANTHROPIC_API_KEY and/or OPENAI_API_KEY (at least one required for LLM calls)
FAL_KEY=
# Optional explicit model (LiteLLM id). Examples:
# LLM_MODEL=anthropic/claude-sonnet-4-5
# LLM_MODEL=openai/gpt-4o
# Legacy alias still works: CLAUDE_MODEL=anthropic/claude-sonnet-4-5
# If unset: OpenAI-only → openai/gpt-4o; otherwise → anthropic/claude-sonnet-4-5
LOCKED_FONT_FAMILY=DM Sans
LOCKED_FONT_URL=https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400&display=swap
# RECRAFT_MODEL=fal-ai/recraft/v3/text-to-image

# --- Auth + DB (multi-tenant) ---
# Postgres (docker compose sets this for the api service automatically)
DATABASE_URL=postgresql+psycopg://postner:postner@localhost:5434/postner
JWT_SECRET=change-me-in-production
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=10080
# CORS_ORIGINS=http://localhost:3000

# --- Object storage (required — all media lives here; no local disk backend) ---
# Docker Compose defaults to MinIO (see docker-compose.yml). Override for prod R2/S3:
# STORAGE_BACKEND=s3
# STORAGE_BUCKET=postner
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
# STORAGE_ADDRESSING_STYLE=auto
# MinIO (local): addressing_style=path; PUBLIC_BASE_URL must be reachable from the browser
# STORAGE_ADDRESSING_STYLE=path
# STORAGE_ENDPOINT_URL=http://minio:9000
# STORAGE_PUBLIC_BASE_URL=http://localhost:9000/postner
