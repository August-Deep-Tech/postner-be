# LLM key for Stagehand (use the provider that matches STAGEHAND_MODEL)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional override — defaults to anthropic/claude-sonnet-4-6 in capture-test.ts
# STAGEHAND_MODEL=anthropic/claude-sonnet-4-6
# STAGEHAND_MODEL=openai/gpt-4o

# Target app under test
APP_URL=https://your-app-url.com
APP_EMAIL=test-account-email
APP_PASSWORD=test-account-password
